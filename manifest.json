{
  "manifest_version": 3,
  "name": "Vault Secrets Finder",
  "version": "1.0",
  "description": "Поиск и копирование секретов из Hashicorp Vault.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vault-finder@yourdomain.com"
    }
  }
}

